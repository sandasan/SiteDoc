{
  "manifest_version": 3,
  "name": "SiteDoc — офлайн-библиотека сайтов",
  "version": "0.11.0",
  "description": "Сохраняйте страницы сайтов в коллекции и экспортируйте их в EPUB или PDF.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "downloads", "alarms", "contextMenus"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "save-current-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Сохранить текущую страницу в SiteDoc"
    },
    "scan-current-section": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Найти страницы текущего раздела"
    },
    "open-collection": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Открыть коллекцию SiteDoc"
    }
  },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Добавить страницу в SiteDoc", "default_popup": "popup.html" },
  "options_page": "library.html"
}
